# Supabase Auth Configuration (if applicable)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-supabase-project.supabase.co/auth/v1/.well-known/jwks.json

# Database Configuration (PostgreSQL / Supabase / Local PostgreSQL)
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Django Settings
SECRET_KEY=django-insecure-your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=True

# JWT Token Settings
ACCESS_TOKEN_LIFETIME_DAYS=1
REFRESH_TOKEN_LIFETIME_DAYS=7

# Port Allocation / Tunneling configuration
RELAY_HOST=localhost
RELAY_PORT_START=40000
RELAY_PORT_END=50000

# Payment Gateway (Stripe) Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Pricing & Billing Defaults
DEFAULT_PRICE_PER_HOUR=2.00
PLATFORM_FEE_PERCENT=10.0
COMPENSATION_PER_HOUR_WASTED=2.00

# Timeout parameters
HEARTBEAT_TIMEOUT_MINUTES=3
IDLE_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=INFO

# Security Settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
